FROM ubuntu:22.04

# Instalar dependencias para simular macOS
RUN apt-get update && apt-get install -y \
    build-essential \
    python3 \
    python3-pip \
    clang \
    llvm \
    libc++-dev \
    libc++abi-dev \
    && rm -rf /var/lib/apt/lists/*

# Configurar variables de entorno para simular macOS
ENV UNAME_S=Darwin
ENV UNAME_M=x86_64
ENV MACOSX_DEPLOYMENT_TARGET=10.15

WORKDIR /app

# Copiar código fuente
COPY . .

# Script de testing para macOS simulado
RUN echo '#!/bin/bash\n\
echo "=== macOS Simulated Testing Environment ==="\n\
echo "Simulating macOS environment..."\n\
echo "UNAME_S: $UNAME_S"\n\
echo "UNAME_M: $UNAME_M"\n\
echo "MACOSX_DEPLOYMENT_TARGET: $MACOSX_DEPLOYMENT_TARGET"\n\
echo ""\n\
cd /app/low\n\
echo "=== Building for macOS (simulated) ==="\n\
make clean\n\
make CC=clang\n\
echo "=== macOS Build Completed ==="\n\
ls -la *.dylib 2>/dev/null || echo "No macOS binaries found"\n\
echo "=== Testing macOS Compatibility ==="\n\
if [ -f "libsysmon.dylib" ]; then\n\
    echo "✅ macOS dylib created successfully"\n\
    file libsysmon.dylib\n\
else\n\
    echo "❌ macOS dylib not found"\n\
fi\n\
echo "=== macOS Testing Complete ==="\n\
' > /app/test-macos.sh && chmod +x /app/test-macos.sh

# Comando por defecto
CMD ["/app/test-macos.sh"]
