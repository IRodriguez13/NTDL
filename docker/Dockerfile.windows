FROM ubuntu:22.04

# Instalar Wine y dependencias para Windows
RUN dpkg --add-architecture i386 && \
    apt-get update && apt-get install -y \
    wine \
    wine32 \
    wine64 \
    mingw-w64 \
    python3 \
    python3-pip \
    wget \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Configurar Wine
ENV WINEPREFIX=/root/.wine
ENV WINEARCH=win64
ENV DISPLAY=:99

# Instalar Visual C++ Runtime y otras dependencias en Wine
RUN wine wineboot --init && \
    wget https://aka.ms/vs/16/release/vc_redist.x64.exe && \
    wine vc_redist.x64.exe /quiet && \
    rm vc_redist.x64.exe

# Instalar Python en Wine para testing
RUN wget https://www.python.org/ftp/python/3.9.0/python-3.9.0-amd64.exe && \
    wine python-3.9.0-amd64.exe /quiet InstallAllUsers=1 PrependPath=1 && \
    rm python-3.9.0-amd64.exe

WORKDIR /app

# Copiar código fuente
COPY . .

# Script de testing para Windows
RUN echo '#!/bin/bash\n\
echo "=== Windows Testing Environment ==="\n\
echo "Wine version: $(wine --version)"\n\
echo "MinGW version: $(x86_64-w64-mingw32-gcc --version | head -1)"\n\
echo "Python in Wine: $(wine python --version 2>/dev/null || echo "Not available")"\n\
echo ""\n\
cd /app/low\n\
echo "=== Building for Windows ==="\n\
make clean\n\
make CC=x86_64-w64-mingw32-gcc\n\
echo "=== Windows Build Completed ==="\n\
ls -la *.dll *.exe 2>/dev/null || echo "No Windows binaries found"\n\
echo "=== Testing Windows Compatibility ==="\n\
if [ -f "sysmon.dll" ]; then\n\
    echo "✅ Windows DLL created successfully"\n\
    file sysmon.dll\n\
else\n\
    echo "❌ Windows DLL not found"\n\
fi\n\
echo "=== Windows Testing Complete ==="\n\
' > /app/test-windows.sh && chmod +x /app/test-windows.sh

# Comando por defecto
CMD ["/app/test-windows.sh"]
